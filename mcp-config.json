{
  "mcpServers": {
    "chrome-devtools": {
      "type": "local",
      "command": "npx",
      "tools": ["*"],
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "tools": [
        "*"
      ]
    },
    "awesome-copilot": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["/Users/pochientsai/Projects/mcp-dotnet-samples/awesome-copilot/publish/McpSamples.AwesomeCopilot.HybridApp.dll"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--viewport-size",
        "1280x720",
        "--allowed-hosts",
        "localhost,127.0.0.1"
      ],
      "tools": [
        "*"
      ]
    }
 }
}
